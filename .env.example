# Settings for the dev site (compose.dev.yaml, bin/dev-site): a fresh WordPress with the child
# theme, the plugins and scripted test content (plan step 4b). bin/dev-site creates .env from this
# file and replaces every "generate" value with a random secret. .env is never committed.

# The dev site's recipe, for Docker Compose commands typed in the repository's folder: the shared
# file and the site's own part, written from site.json by the scripts (template plan 1.2f).
# bin/dev-site writes their places for the site: in a site the shared file is in
# vendor/dts/site-tools/, in the tools' own repository at its top (tools/site-settings.sh,
# dev_compose_files).
COMPOSE_FILE=dev-compose-files

# This project's ports are in the 101xx block.
DEV_SITE_PORT=10102
DEV_MAIL_UI_PORT=10103
DEV_DB_NAME=wordpress
DEV_DB_USER=wordpress
DEV_DB_PASSWORD=generate
DEV_DB_ROOT_PASSWORD=generate
DEV_ADMIN_USER=devadmin
DEV_ADMIN_PASSWORD=generate
DEV_ADMIN_EMAIL=devadmin@example.test
# An Editor, the role a customer gets, so the tests see the admin as a customer does.
DEV_EDITOR_USER=deveditor
DEV_EDITOR_PASSWORD=generate
DEV_EDITOR_EMAIL=deveditor@example.test
