#!/usr/bin/env bash
# Stand-in for rsync in bin/deploy's tests (tests/tools/deploy/run.sh): a stand-in server per
# short name, server/<short name>/<folder>/ in FAKE_SERVICES_DIR, reached the way rsync's daemon
# mode over ssh reaches "<short name>::<folder>/": only the folders that exist there (the ones
# the key's settings name); reading a file, listing a folder (--list-only), copying a file into
# one, and making a folder exactly a local one (-r --delete --checksum --itemize-changes, the
# only copy bin/deploy makes, also as a --dry-run). That copy is made by this computer's real
# rsync between local folders, so its lists are rsync's own (template plan 2.1e); only the network
# is stood in for. An old copy keeping file times (-t) is refused as unexpected. Every real copy
# (not a dry run) is written to writes.txt. It refuses to run unless ssh is told never to ask for
# a password (BatchMode). A short name in unreachable.txt does not answer; a copy into the folder
# the situation names as copyFailsAt fails, and one into interruptAt interrupts bin/deploy as
# Ctrl+C would; plantBeforeCopy and plantAfterCopy name a folder into which a file appears on the
# server just before or just after its real copy, as a change outside the deploy would.
set -Euo pipefail

readonly SERVER="$FAKE_SERVICES_DIR/server"
readonly SITUATION="$FAKE_SERVICES_DIR/situation.json"
# rsync's own exit statuses.
readonly RSYNC_SYNTAX_ERROR=1
readonly RSYNC_UNKNOWN_MODULE=5
readonly RSYNC_IO_ERROR=12
readonly RSYNC_FILE_MISSING=23
readonly SSH_FAILED=255
readonly MIRROR_OPTIONS="-r --delete --checksum --itemize-changes"
readonly PLANTED_FILE="planted-on-the-server.txt"

remote_shell="" options="" paths=()
read_arguments() {
  while (($# > 0)); do
    case "$1" in
      -e) remote_shell="$2" && shift 2 ;;
      -q) shift ;;
      --list-only | -r | --delete | --checksum | --itemize-changes | --dry-run) options+="${options:+ }$1" && shift ;;
      -*) echo "fake rsync: unexpected option $1" >&2; exit "$RSYNC_SYNTAX_ERROR" ;;
      *) paths+=("$1") && shift ;;
    esac
  done
  printf '%s\n' "$remote_shell" >>"$FAKE_SERVICES_DIR/remote-shells.txt"
  [[ "$remote_shell" == *"BatchMode=yes"* ]] || { echo "fake rsync: ssh may ask for a password (no BatchMode=yes): $remote_shell" >&2; exit "$RSYNC_SYNTAX_ERROR"; }
}

# Splits "<short name>::<folder>/<path>" into SSH_HOST, FOLDER and FOLDER_PATH, refusing what the
# server would refuse: a short name that does not answer, a folder the key's settings do not name.
SSH_HOST="" FOLDER="" FOLDER_PATH=""
reach() {
  [[ "$1" =~ ^([A-Za-z0-9._-]+)::([^/]+)/?(.*)$ ]] || { echo "fake rsync: not a server path: $1" >&2; exit "$RSYNC_SYNTAX_ERROR"; }
  SSH_HOST="${BASH_REMATCH[1]}" FOLDER="${BASH_REMATCH[2]}" FOLDER_PATH="${BASH_REMATCH[3]}"
  if grep -qxF -- "$SSH_HOST" "$FAKE_SERVICES_DIR/unreachable.txt" 2>/dev/null; then
    echo "ssh: connect to host $SSH_HOST port 22: Connection timed out" >&2
    exit "$SSH_FAILED"
  fi
  [[ -d "$SERVER/$SSH_HOST/$FOLDER" ]] || { echo "@ERROR: Unknown module '$FOLDER'" >&2; exit "$RSYNC_UNKNOWN_MODULE"; }
}

list_folder() {
  reach "$1"
  printf 'drwxr-xr-x          4,096 2026/01/01 00:00:00 .\n'
  find "$SERVER/$SSH_HOST/$FOLDER" -mindepth 1 -maxdepth 1 -printf '%M %12s 2026/01/01 00:00:00 %f\n'
}

read_file() {
  reach "$1"
  [[ -f "$SERVER/$SSH_HOST/$FOLDER/$FOLDER_PATH" ]] || { echo "rsync: link_stat \"$FOLDER_PATH\" (in $FOLDER) failed: No such file or directory (2)" >&2; exit "$RSYNC_FILE_MISSING"; }
  cp "$SERVER/$SSH_HOST/$FOLDER/$FOLDER_PATH" "$2"
}

# This computer's own rsync: the first one on the search path that is not this stand-in.
real_rsync() {
  local candidate
  while IFS= read -r candidate; do
    [[ "$candidate" -ef "${BASH_SOURCE[0]}" ]] || { printf '%s' "$candidate"; return 0; }
  done < <(type -ap rsync)
  echo "fake rsync: this computer has no rsync of its own; the deploy tests need it" >&2
  exit "$RSYNC_SYNTAX_ERROR"
}

# The mirror copy itself, by the real rsync between local folders; the options are split into
# words on purpose (they hold no spaces).
mirror() {
  local source_path="$1" target="$2" rsync_path
  shift 2
  rsync_path="$(real_rsync)" || exit "$RSYNC_SYNTAX_ERROR"
  # shellcheck disable=SC2086
  "$rsync_path" $MIRROR_OPTIONS "$@" "$source_path/" "$target/"
}

# A file appearing in the folder on the server when the situation names it for this moment.
plant_if_named() {
  local field="$1" target="$2"
  [[ "$(jq -r --arg field "$field" '.[$field] // empty' "$SITUATION")" == "$FOLDER" ]] || return 0
  printf 'changed outside the deploy\n' >"$target/$PLANTED_FILE"
}

# A failed copy, or the user pressing Ctrl+C during it. Ctrl+C reaches the whole foreground group,
# so both bin/deploy (which runs this stand-in directly) and rsync get the signal; bash runs its
# trap only when the child it waited for died of the signal too, so this stand-in ends by it.
fail_or_interrupt_if_named() {
  [[ "$(jq -r '.copyFailsAt // empty' "$SITUATION")" != "$FOLDER" ]] || { echo "rsync: write failed on \"$FOLDER\": No space left on device (28)" >&2; exit "$RSYNC_IO_ERROR"; }
  [[ "$(jq -r '.interruptAt // empty' "$SITUATION")" == "$FOLDER" ]] || return 0
  kill -INT "$PPID"
  trap - INT
  kill -INT "$$"
}

copy_in() {
  local source_path="$1" target
  reach "$2"
  target="$SERVER/$SSH_HOST/$FOLDER"
  if [[ "$options" == "$MIRROR_OPTIONS --dry-run" && -d "$source_path" ]]; then
    mirror "$source_path" "$target" --dry-run
    return
  fi
  printf '%s::%s\n' "$SSH_HOST" "$FOLDER" >>"$FAKE_SERVICES_DIR/writes.txt"
  fail_or_interrupt_if_named
  if [[ "$options" == "$MIRROR_OPTIONS" && -d "$source_path" ]]; then
    plant_if_named plantBeforeCopy "$target"
    mirror "$source_path" "$target"
    plant_if_named plantAfterCopy "$target"
  elif [[ -z "$options" && -f "$source_path" && -n "$FOLDER_PATH" ]]; then
    cp "$source_path" "$target/$FOLDER_PATH"
  else
    echo "fake rsync: a copy bin/deploy never makes: $options $source_path" >&2
    exit "$RSYNC_SYNTAX_ERROR"
  fi
}

main() {
  read_arguments "$@"
  if [[ "$options" == --list-only ]]; then
    ((${#paths[@]} == 1)) || { echo "fake rsync: --list-only takes one server path" >&2; exit "$RSYNC_SYNTAX_ERROR"; }
    list_folder "${paths[0]}"
    return
  fi
  ((${#paths[@]} == 2)) || { echo "fake rsync: expected a source and a destination" >&2; exit "$RSYNC_SYNTAX_ERROR"; }
  if [[ "${paths[1]}" == *::* ]]; then
    copy_in "${paths[0]}" "${paths[1]}"
  else
    read_file "${paths[0]}" "${paths[1]}"
  fi
}

main "$@"
